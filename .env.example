# ============================================================================
# Vrodux ERP — Production Environment Variables
# Copy to /opt/vrodux/shared/.env and fill in real values.
# NEVER commit this file with real secrets.
# ============================================================================

# ── Domain ─────────────────────────────────────────────────────────────────
DOMAIN=erp.vrodux.com

# ── Docker Image Tags ─────────────────────────────────────────────────────
IMAGE_TAG=latest
GITHUB_REPOSITORY=your-org/vrodux-erp-product

# ── SQL Server ─────────────────────────────────────────────────────────────
SQL_SA_PASSWORD=CHANGE_ME_StrongPassword123!

# ── Redis ──────────────────────────────────────────────────────────────────
REDIS_PASSWORD=CHANGE_ME_RedisPassword456!

# ── JWT (minimum 64 characters, random) ───────────────────────────────────
JWT_SECRET=CHANGE_ME_GENERATE_A_LONG_RANDOM_STRING_AT_LEAST_64_CHARACTERS_LONG

# ── Email (SMTP) ──────────────────────────────────────────────────────────
SMTP_HOST=smtp.zoho.com
SMTP_PORT=587
SMTP_USERNAME=your-email@yourdomain.com
SMTP_PASSWORD=CHANGE_ME_SmtpPassword
SMTP_FROM_ADDRESS=noreply@yourdomain.com
SMTP_FROM_NAME=Vrodux ERP

# ── Seq (Structured Logging) ──────────────────────────────────────────────
SEQ_API_KEY=

# ── Monitoring (Grafana) ──────────────────────────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_GrafanaPassword789!

# ── Backup Encryption ─────────────────────────────────────────────────────
BACKUP_ENCRYPTION_KEY=CHANGE_ME_BackupEncryptionKey

# ── S3/B2 Remote Backup (optional) ────────────────────────────────────────
# S3_BACKUP_BUCKET=vrodux-backups
# S3_ENDPOINT=https://s3.us-west-001.backblazeb2.com
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ── Frontend Build Args ───────────────────────────────────────────────────
VITE_API_URL=https://erp.vrodux.com

# ── Integration Platform (lead sources) ───────────────────────────────────
# Public base URL of the gateway — embedded in inbound webhook URLs (must be
# publicly reachable / HTTPS for Meta & other providers; use ngrok in dev).
Integrations__PublicBaseUrl=https://erp.vrodux.com
Integrations__FrontendBaseUrl=https://erp.vrodux.com

# Meta (Facebook / Instagram) Lead Ads — one app shared by all tenants.
# Create an app at developers.facebook.com, add the Webhooks + Leads Retrieval
# products, whitelist https://<DOMAIN>/api/crm/integrations/meta/oauth/callback as the
# OAuth redirect, and set the webhook callback to https://<DOMAIN>/api/webhooks/meta
# (verify token = META_VERIFY_TOKEN, subscribe field = leadgen).
# Consumed by docker-compose.prod.yml → vrodux-api.
META_APP_ID=
META_APP_SECRET=CHANGE_ME_MetaAppSecret
META_VERIFY_TOKEN=vrodux-meta-verify
META_GRAPH_VERSION=v21.0

# ── Billing / Subscriptions ───────────────────────────────────────────────
# Public origin the payment providers redirect back to (must be externally reachable).
Billing__PublicBaseUrl=https://erp.vrodux.com
Billing__Currency=USD

# Stripe — create one recurring Price per tier AND cadence in the dashboard, then paste
# the price ids below. Webhook endpoint: https://<DOMAIN>/api/billing/webhooks/stripe
# subscribing to: checkout.session.completed, customer.subscription.created/updated/deleted,
# invoice.paid, invoice.payment_failed. WebhookSecret is the whsec_… shown when you create it —
# without it every webhook is rejected (the endpoint fails closed by design).
Billing__Stripe__Enabled=false
Billing__Stripe__SecretKey=CHANGE_ME_StripeSecretKey
Billing__Stripe__PublishableKey=
Billing__Stripe__WebhookSecret=CHANGE_ME_StripeWebhookSecret
Billing__Stripe__Prices__Micro__Monthly=
Billing__Stripe__Prices__Micro__Annual=
Billing__Stripe__Prices__Starter__Monthly=
Billing__Stripe__Prices__Starter__Annual=
Billing__Stripe__Prices__Professional__Monthly=
Billing__Stripe__Prices__Professional__Annual=

# PayPal — create a Product + one Billing Plan per tier/cadence, then paste the plan ids.
# Webhook endpoint: https://<DOMAIN>/api/billing/webhooks/paypal subscribing to
# BILLING.SUBSCRIPTION.ACTIVATED/CANCELLED/EXPIRED/SUSPENDED and PAYMENT.SALE.COMPLETED.
# WebhookId is required — signature verification calls PayPal with it.
# Set UseSandbox=false only when you intend to charge real cards.
Billing__PayPal__Enabled=false
Billing__PayPal__ClientId=
Billing__PayPal__ClientSecret=CHANGE_ME_PayPalClientSecret
Billing__PayPal__WebhookId=
Billing__PayPal__UseSandbox=true
Billing__PayPal__Plans__Micro__Monthly=
Billing__PayPal__Plans__Micro__Annual=
Billing__PayPal__Plans__Starter__Monthly=
Billing__PayPal__Plans__Starter__Annual=
Billing__PayPal__Plans__Professional__Monthly=
Billing__PayPal__Plans__Professional__Annual=
