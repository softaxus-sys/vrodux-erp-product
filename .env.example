# ============================================================================
# Vrodux ERP — Production Environment Variables
# Copy to /opt/vrodux/shared/.env and fill in real values.
# NEVER commit this file with real secrets.
# ============================================================================

# ── Domain ─────────────────────────────────────────────────────────────────
DOMAIN=erp.vrodux.com

# ── Docker Image Tags ─────────────────────────────────────────────────────
IMAGE_TAG=latest
GITHUB_REPOSITORY=your-org/vrodux-erp-product

# ── SQL Server ─────────────────────────────────────────────────────────────
SQL_SA_PASSWORD=CHANGE_ME_StrongPassword123!

# ── Redis ──────────────────────────────────────────────────────────────────
REDIS_PASSWORD=CHANGE_ME_RedisPassword456!

# ── JWT (minimum 64 characters, random) ───────────────────────────────────
JWT_SECRET=CHANGE_ME_GENERATE_A_LONG_RANDOM_STRING_AT_LEAST_64_CHARACTERS_LONG

# ── Email (SMTP) ──────────────────────────────────────────────────────────
# ZeptoMail (vrodux.com). Username is the literal "emailapikey"; the password is the SMTP token
# from ZeptoMail → Mail Agents → SMTP. FROM must be on the verified vrodux.com domain.
SMTP_HOST=smtp.zeptomail.com
SMTP_PORT=465
SMTP_USERNAME=emailapikey
SMTP_PASSWORD=CHANGE_ME_ZeptoMail_SMTP_token
SMTP_FROM_ADDRESS=noreply@vrodux.com
SMTP_FROM_NAME=Vrodux ERP

# ── Seq (Structured Logging) ──────────────────────────────────────────────
SEQ_API_KEY=

# ── Monitoring (Grafana) ──────────────────────────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_GrafanaPassword789!

# ── Backup Encryption ─────────────────────────────────────────────────────
BACKUP_ENCRYPTION_KEY=CHANGE_ME_BackupEncryptionKey

# ── S3/B2 Remote Backup (optional) ────────────────────────────────────────
# S3_BACKUP_BUCKET=vrodux-backups
# S3_ENDPOINT=https://s3.us-west-001.backblazeb2.com
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ── Frontend Build Args ───────────────────────────────────────────────────
VITE_API_URL=https://erp.vrodux.com

# ── Integration Platform (lead sources) ───────────────────────────────────
# Public base URL of the gateway — embedded in inbound webhook URLs (must be
# publicly reachable / HTTPS for Meta & other providers; use ngrok in dev).
Integrations__PublicBaseUrl=https://erp.vrodux.com
Integrations__FrontendBaseUrl=https://erp.vrodux.com
# Comma-separated. Emailed when a lead-source integration starts failing and when it recovers.
INTEGRATION_ALERT_EMAILS=shahbaz@softaxis.ae

# Meta (Facebook / Instagram) Lead Ads — one app shared by all tenants.
# Create an app at developers.facebook.com, add the Webhooks + Leads Retrieval
# products, whitelist https://<DOMAIN>/api/crm/integrations/meta/oauth/callback as the
# OAuth redirect, and set the webhook callback to https://<DOMAIN>/api/webhooks/meta
# (verify token = META_VERIFY_TOKEN, subscribe field = leadgen).
# Consumed by docker-compose.prod.yml → vrodux-api.
META_APP_ID=
META_APP_SECRET=CHANGE_ME_MetaAppSecret
META_VERIFY_TOKEN=vrodux-meta-verify
META_GRAPH_VERSION=v21.0

# Google (SEO AI Agent module) — one OAuth app shared by all tenants, covers BOTH Search
# Console and Analytics in one consent screen (see Google__Scopes in appsettings — both
# scopes are requested together). In Google Cloud Console: create an OAuth 2.0 Client ID
# (Web application), enable the "Google Search Console API" and "Google Analytics Admin
# API", and whitelist https://<DOMAIN>/api/seo/google/oauth/callback as an Authorized
# redirect URI. Consumed by docker-compose.prod.yml → vrodux-api.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=CHANGE_ME_GoogleClientSecret

# Qasro (qasro.com) — Softaxis's sister property portal. Real OAuth, same shape as the Google
# integration above: a tenant admin clicks "Connect Qasro" and is redirected to Qasro to log in
# or sign up and approve the connection from their own agency dashboard there (agency must be
# approved/active on Qasro) — Vrodux never pushes credentials blindly. Register Vrodux as an
# OAuth client on Qasro's side and whitelist
# https://<DOMAIN>/api/real-estate/qasro-integration/oauth/callback as the redirect URI.
#
# QASRO_API_BASE_URL must be Qasro's CANONICAL host — not one that 3xx-redirects to another
# (e.g. Vercel's apex→www redirect). QasroClient disables auto-redirect on purpose, so a
# misconfigured host now fails loudly with the real cause instead of a confusing downstream 401
# (a cross-host redirect silently drops the Authorization header on the pull-key/unlink calls).
# Confirmed for Qasro: use https://www.qasro.com, not https://qasro.com.
QASRO_SITE_URL=https://qasro.com
QASRO_API_BASE_URL=https://www.qasro.com
QASRO_CLIENT_ID=vrodux
QASRO_CLIENT_SECRET=CHANGE_ME_QasroClientSecret

# Object storage (Contabo, S3-compatible) — one bucket for every Vrodux module's files (property
# photos first; HR avatars, Finance receipts, Visa case documents are follow-up candidates). Left
# blank, every module falls back to its existing legacy DB-column storage — nothing breaks, this
# is purely additive. STORAGE_ENDPOINT has no bucket name in it (that's STORAGE_BUCKET separately).
#
# ⚠ STORAGE_BUCKET is NOT just the bucket's display name. Contabo's S3 API identifies a bucket as
# "<tenantId>:<bucketName>" — the tenant id is account-wide (the same prefix on every bucket you
# own), visible by enabling public sharing on any object in the Contabo panel, or already present
# in any bucket URL Contabo shows you (e.g. https://sin1.contabostorage.com/<tenantId>:<bucket>).
# Using the bare bucket name ("vrodux-media" alone) looks plausible and compiles fine, but every
# S3 call fails because that bucket, under that name alone, does not exist from the API's
# perspective — confirmed the hard way. Set the FULL value, e.g.:
#   STORAGE_BUCKET=5eebb73791834c68aa89cf1633f74425:vrodux-media
#
# Qasro's bucket + credentials are entirely separate and must NEVER be set here — by default a
# Contabo access key has access to every bucket on the account, so real isolation between the two
# products' buckets needs an explicit S3 bucket policy restricting each key to its own bucket, not
# just using two different buckets with the same key.
STORAGE_ENDPOINT=
STORAGE_BUCKET=CHANGE_ME_tenantId:vrodux-media
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=CHANGE_ME_StorageSecretKey

# ── Billing / Subscriptions ───────────────────────────────────────────────
# Vrodux's OWN Stripe + PayPal accounts — the platform charges tenants with these.
# NOT the same as the POS "payment gateway" settings, which are per-tenant and live in
# the database so each tenant can charge their own customers.
#
# Consumed by docker-compose.prod.yml -> vrodux-api. Each provider stays disabled (and is
# hidden from the billing UI) until its *_ENABLED flag is true AND credentials are present,
# so a half-finished setup can never show a customer a broken checkout button.
#
# SECRETS ONLY LIVE HERE. The *_SECRET / *_CLIENT_ID / *_WEBHOOK_* values below are the only
# billing settings that require this file and a restart — putting a live payment secret in the
# database would widen a DB read or leaked backup into "can charge cards as us".
# Everything else (enabling a provider, the price/plan ids, sandbox, currency) is editable
# without a redeploy in Super Admin -> Billing Setup, and once saved there it OVERRIDES the
# values below. The *_ENABLED / *_PRICE_ / *_PLAN_ entries here are just the bootstrap defaults
# used until that screen is saved for the first time.
BILLING_CURRENCY=USD

# Stripe — create one recurring Price per tier AND cadence in the dashboard, then paste the
# price ids (price_...) below. They are not secret.
# Webhook endpoint: https://<DOMAIN>/api/billing/webhooks/stripe subscribing to
#   checkout.session.completed, customer.subscription.created/updated/deleted,
#   invoice.paid, invoice.payment_failed
# STRIPE_WEBHOOK_SECRET is the whsec_... shown when you create that endpoint. Without it every
# webhook is rejected — the endpoint fails closed by design, so payments would never activate.
STRIPE_ENABLED=false
STRIPE_SECRET_KEY=CHANGE_ME_StripeSecretKey
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=CHANGE_ME_StripeWebhookSecret
STRIPE_PRICE_MICRO_MONTHLY=
STRIPE_PRICE_MICRO_ANNUAL=
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_STARTER_ANNUAL=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=

# PayPal — create a Product plus one Billing Plan per tier/cadence, then paste the plan ids (P-...).
# Webhook endpoint: https://<DOMAIN>/api/billing/webhooks/paypal subscribing to
#   BILLING.SUBSCRIPTION.ACTIVATED / CANCELLED / EXPIRED / SUSPENDED, PAYMENT.SALE.COMPLETED
# PAYPAL_WEBHOOK_ID is required — signature verification calls PayPal with it.
# Set PAYPAL_USE_SANDBOX=false only when you intend to charge real cards.
PAYPAL_ENABLED=false
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=CHANGE_ME_PayPalClientSecret
PAYPAL_WEBHOOK_ID=
PAYPAL_USE_SANDBOX=true
PAYPAL_PLAN_MICRO_MONTHLY=
PAYPAL_PLAN_MICRO_ANNUAL=
PAYPAL_PLAN_STARTER_MONTHLY=
PAYPAL_PLAN_STARTER_ANNUAL=
PAYPAL_PLAN_PRO_MONTHLY=
PAYPAL_PLAN_PRO_ANNUAL=

# ── On-premises licence signing (cloud server only) ───────────────────────
# RSA private key PEM that signs licence keys, on one line with literal \n for newlines.
# Must match the public key compiled into LicenseService.cs, or issued keys won't validate.
LICENSE_RSA_PRIVATE_KEY_PEM=
