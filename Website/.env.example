# Where enquiries are delivered.
# Create the integration in VroduxERP: Settings -> Integrations -> Website Forms -> Connect.
# Copy the inbound URL it gives you (it already contains the unguessable inbound key).
CRM_INBOUND_URL=https://erp.vrodux.com/api/webhooks/REPLACE_WITH_INBOUND_KEY

# Optional. Only set this if you enabled HMAC signing on the integration.
CRM_SIGNING_SECRET=

# Shown in the footer / contact page.
NEXT_PUBLIC_SITE_URL=https://example.ae
NEXT_PUBLIC_PHONE=+971 4 2445777
NEXT_PUBLIC_WHATSAPP=971500000000
NEXT_PUBLIC_EMAIL=hello@example.ae
