# ── .NET ──────────────────────────────────────────────
bin/
obj/
[Dd]ebug/
[Rr]elease/
*.user
*.suo
.vs/
artifacts/
project.lock.json

# ── Node / Vite (FrontendVite) ────────────────────────
node_modules/
dist/
dist-ssr/
*.local
.vite/

# ── Env / secrets ─────────────────────────────────────
.env
.env.*
!.env.example
# Local dev overrides hold real credentials — never commit
appsettings.Development.json
appsettings.*.Local.json
secrets.json
# ASP.NET Core Data Protection key ring (encrypts stored OAuth tokens/secrets) — never commit
App_Data/

# ── Deploy / build output ─────────────────────────────
Deploy/server/output/
FrontendVite/release/

# ── Logs / OS ─────────────────────────────────────────
*.log
npm-debug.log*
Thumbs.db
.DS_Store

# ── Legacy Next.js frontend (removed in "completed POS Resturant Module") ──
# The directory was deleted from git but build output (.next/, node_modules/) still sits on
# disk for anyone who ran it before. Its own .gitignore went with it, so without this a
# `git add -A` silently re-commits ~148 build-cache files. The live app is FrontendVite/.
Frontend/
