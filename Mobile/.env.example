# Copy to .env.local and point at your running ApiGateway.
#
# EXPO_PUBLIC_* vars are inlined into the JS bundle at build time (Expo's
# built-in env support, no extra config needed) -- fine for a base API URL,
# never put secrets in an EXPO_PUBLIC_ var.
#
# - iOS Simulator / Android Emulator on the same machine as the gateway:
#     http://localhost:5000  (Android emulator: http://10.0.2.2:5000)
# - Physical device on the same Wi-Fi as your dev machine:
#     http://<your-lan-ip>:5000   e.g. http://192.168.1.50:5000
#     (localhost on a phone means the phone itself, not your PC)
EXPO_PUBLIC_API_URL=http://localhost:5000
