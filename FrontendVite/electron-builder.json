{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "com.vrodux.erp",
  "productName": "Vrodux ERP",
  "directories": {
    "output": "release"
  },
  "files": [
    "dist/**/*",
    "electron/**/*",
    "public/vrodux-logo.png"
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      }
    ],
    "icon": "public/vrodux-icon.ico",
    "artifactName": "VroduxERP-Setup-${version}.${ext}"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "installerIcon": "public/vrodux-icon.ico",
    "uninstallerIcon": "public/vrodux-icon.ico",
    "installerHeaderIcon": "public/vrodux-icon.ico",
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Vrodux ERP"
  }
}
