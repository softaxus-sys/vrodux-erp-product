        "easyTitle": "Embed the ready-made form",
        "easyDesc": "Zero coding — paste this iframe on any page. Submissions appear in CRM → Leads automatically.",
        "preview": "Preview the form",
        "step1": "Copy the iframe above.",
        "step2": "Paste it into your website's HTML where you want the form to appear.",
        "step3": "Every submission is captured as a lead under your account — with dedupe & routing applied.",
        "advTitle": "Use your own form",
        "advDesc": "Two ways to send your existing/custom form to Vrodux.",
        "optionA": "Option A — Drop-in script (no backend)",
        "optionAHint": "Add the script once, then put <c>data-vrodux-lead</c> on any form:",
        "optionB": "Option B — POST directly from your backend"
      },
      "sheets": {
        "title": "Turn new spreadsheet rows into leads",
        "desc": "A one-time Apps Script posts each new row to Vrodux. Your header row names become the lead fields.",
        "step1": "Open your Google Sheet → <c>Extensions</c> → <c>Apps Script</c>.",
        "step2": "Delete any sample code, paste the script above, and <c>Save</c>.",
        "step3": "Click <c>Triggers</c> (clock icon) → <c>Add Trigger</c>.",
        "step4": "Choose function <c>vroduxSendRow</c>, event source <c>From spreadsheet</c>, event type <c>On form submit</c> (or <c>On edit</c> for manual rows), then <c>Save</c> and authorize.",
        "step5": "Make sure row 1 has headers like <c>name</c>, <c>email</c>, <c>phone</c>, <c>company</c>, <c>interested_in</c>, <c>budget</c>, <c>message</c>."
      },
      "forms": {
        "title": "Send Google Forms responses to CRM",
        "desc": "A one-time Apps Script posts each response to Vrodux. Name your form questions to match the CRM fields.",
        "step1": "Open your Google Form → <c>⋮</c> menu → <c>Apps Script</c> (or Extensions → Apps Script).",
        "step2": "Paste the script above and <c>Save</c>.",
        "step3": "Click <c>Triggers</c> → <c>Add Trigger</c> → function <c>vroduxOnFormSubmit</c>, event type <c>On form submit</c>. Save & authorize.",
        "step4": "Tip: name your questions <c>Email</c>, <c>Phone</c>, <c>Company</c>, <c>Interested in</c>, <c>Budget</c>, <c>Message</c> so they map automatically. Unrecognized questions are still saved under the lead's Form Responses."
      },
      "pf": {
        "title": "Connect Property Finder leads",
        "desc": "Every buyer/tenant enquiry on your Property Finder listings — email, call, WhatsApp or SMS — is created as a CRM lead, with the property, price and message attached.",
        "step1": "In your Property Finder <b>agent / broker portal</b>, open <c>Settings</c> → <c>Integrations</c> (or <c>Leads</c> → <c>CRM / API</c>). If you use a lead-management partner, this is where a webhook / CRM endpoint is configured.",
        "step2": "Add a <b>webhook / lead-forwarding</b> destination and paste the inbound URL above as the target. Choose <c>JSON</c> as the format if asked.",
        "step3": "Save. Send a test enquiry from one of your live listings — it should appear under <b>CRM → Leads</b> within a few seconds, with dedupe & routing applied.",
        "note": "Property Finder's lead delivery is enabled per account — if you don't see a webhook / API option, ask your Property Finder account manager to enable <b>lead export / CRM integration</b>, or forward leads via an automation tool (Zapier / Make) to the URL above.",
        "payloadTitle": "Payload Vrodux understands",
        "payloadDesc": "Property Finder (or your automation) should POST JSON like this. The enquirer can be nested under client/contact; the listing under property/listing. Unknown fields are still saved under the lead's Form Responses.",
        "mappedHint": "Mapped automatically: <c>name · email · phone · message → the lead; property title + reference → Interested In; price + offering → Budget; location → City</c>.",
        "testTitle": "Test it from a terminal",
        "testDesc": "Fire a sample enquiry at your inbound URL to confirm the connection.",
        "hmacTitle": "Optional — verify signatures (HMAC)",
        "hmacDesc": "If Property Finder (or your middleware) signs the request body, store the signing secret in the Inbound URL tab and Vrodux will verify it.",
        "hmacStep1": "Reveal / set your <b>signing secret</b> in the <c>Inbound URL</c> tab.",
        "hmacStep2": "Sign the raw body with <c>HMAC-SHA256</c> (lowercase hex) and send it as <c>X-PropertyFinder-Signature: sha256=&lt;hex&gt;</c> (or <c>X-Signature</c>). Unsigned requests are still accepted on the strength of the unguessable inbound URL."
      },
      "calendly": {
        "title": "Create a Calendly webhook",
        "desc": "Calendly delivers new bookings to your inbound URL. Webhooks require a Calendly paid plan / API access.",
        "step1": "In Calendly, go to <c>Integrations & apps</c> → <c>API & webhooks</c> → generate a <b>Personal Access Token</b>.",
        "step2": "Find your organization URI (copy <c>current_organization</c> from the response):",
        "step3": "Create the webhook subscription pointing at your inbound URL (replace the token & organization):",
        "step4": "Done — each new Calendly booking (<c>invitee.created</c>) now creates a CRM lead. The invitee's name, email and any questions are captured."
      },
      "generic": {
        "title": "Push leads to your inbound URL",
        "desc": "Any tool or backend that can POST JSON can send leads here. Possession of the URL is the secret — keep it private.",
        "zapierTitle": "Connect from Zapier",
        "makeTitle": "Connect from Make.com",
        "step1": "Add a <c>Webhooks</c> action → <c>POST</c>.",
        "step2": "Set the URL to the inbound URL above and payload type <c>JSON</c>.",
        "step3Zapier": "Map your trigger's fields to the accepted field names, then turn the Zap on.",
        "step3Make": "Map your trigger's fields to the accepted field names, then turn the scenario on.",
        "hmacTitle": "Optional — sign your requests (HMAC)",
        "hmacDesc": "For extra security, sign the raw request body so Vrodux can verify it came from you.",
        "hmacStep1": "Reveal your <b>signing secret</b> in the <c>Inbound URL</c> tab.",
        "hmacStep2": "Compute <c>HMAC-SHA256(rawBody, secret)</c> as lowercase hex.",
        "hmacStep3": "Send it in the header <c>X-Vrodux-Signature: sha256=&lt;hex&gt;</c>. Unsigned requests are still accepted unless you require signing."
      }
    },
